# Copy to .env (never commit .env) and load it with:
#   set -a; source .env; set +a
# Then run: dart run bin/server.dart

# Required. Create a key at https://platform.claude.com (API usage is billed
# separately from Claude.ai / Claude Code subscriptions).
ANTHROPIC_API_KEY=

# Required. Development-only static app tokens: user_id:token pairs, comma
# separated, tokens at least 16 characters. Generate one with:
#   openssl rand -hex 24
# Replace with real user authentication before production.
APP_USER_TOKENS=demo-user:replace-with-a-long-random-token

# Optional.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low
CLAUDE_ENABLE_FALLBACKS=true
MAX_TOOL_ITERATIONS=20
HOST=127.0.0.1
PORT=8080
CORS_ALLOWED_ORIGINS=*
CONVERSATION_TTL_MINUTES=30
REQUESTS_PER_MINUTE=60
